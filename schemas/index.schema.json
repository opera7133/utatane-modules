{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Module catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "channel",
    "signed",
    "modules"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "channel": {
      "enum": ["development", "staging", "stable"]
    },
    "signed": {
      "type": "boolean"
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "displayName",
          "kinds",
          "origin",
          "upstream",
          "delivery",
          "license",
          "licenseURL",
          "instructions",
          "limitations",
          "availability",
          "artifacts"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "kinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "shiori",
                "saori",
                "plugin"
              ]
            }
          },
          "origin": {
            "enum": [
              "upstream-port",
              "independent"
            ]
          },
          "upstream": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "author"
            ],
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https?://[^\\s]+$"
              },
              "author": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "originalURL": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          },
          "delivery": {
            "enum": [
              "binary",
              "instructions-only"
            ]
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "licenseURL": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          },
          "instructions": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "availability": {
            "enum": [
              "candidate",
              "not-built",
              "instructions-only"
            ]
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "version",
                "revision",
                "architectures",
                "minimumOS",
                "abi",
                "verification",
                "signing",
                "path",
                "sha256",
                "size"
              ],
              "properties": {
                "version": {
                  "type": "string",
                  "pattern": "^\\d+\\.\\d+\\.\\d+$"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "architectures": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "arm64",
                      "x86_64"
                    ]
                  }
                },
                "minimumOS": {
                  "type": "string",
                  "pattern": "^\\d+\\.\\d+$"
                },
                "abi": {
                  "type": "string",
                  "minLength": 1
                },
                "verification": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "nativeABI",
                    "utataneUI"
                  ],
                  "properties": {
                    "nativeABI": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "enum": [
                          "arm64",
                          "x86_64"
                        ]
                      }
                    },
                    "utataneUI": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": { "type": "string", "minLength": 1 }
                    }
                  }
                },
                "signing": {
                  "const": "ad-hoc"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "size": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "delivery": {
                  "const": "instructions-only"
                }
              }
            },
            "then": {
              "properties": {
                "artifacts": {
                  "maxItems": 0
                },
                "availability": {
                  "const": "instructions-only"
                }
              }
            },
            "else": {
              "if": {
                "properties": {
                  "artifacts": {
                    "minItems": 1
                  }
                }
              },
              "then": {
                "properties": {
                  "availability": {
                    "const": "candidate"
                  }
                }
              },
              "else": {
                "properties": {
                  "availability": {
                    "const": "not-built"
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "channel": { "const": "development" } } },
      "then": { "properties": { "signed": { "const": false } } },
      "else": { "properties": { "signed": { "const": true } } }
    }
  ]
}
